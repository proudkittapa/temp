# Copy to deploy/.env on the server (never commit it) and fill in.

# Your domain, pointed at this server (DNS A record). Caddy gets the HTTPS
# certificate automatically. Leave as :80 to test by IP address over HTTP.
SITE_ADDRESS=:80

# Database password - long and random, letters and digits only (it goes into
# a URL): openssl rand -hex 24
POSTGRES_PASSWORD=
