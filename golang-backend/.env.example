# DATABASE_URL: PostgreSQL Connection String
DATABASE_URL=postgres://arena_user:ArenaSecurePass99@localhost:5432/arena_db?sslmode=disable

# PORT: The port that Go Backend listens on
PORT=8080

# JWT_SECRET: signs login tokens. Generate your own, e.g. `openssl rand -hex 32`.
# If unset (or left at the old published example value) the server uses a
# random secret per run - safe, but everyone is logged out on restart.
JWT_SECRET=

# PROMPTPAY_ID: merchant PromptPay ID (phone or 13-digit tax ID) that
# customers' QR codes pay to. Defaults to 0105561008012.
PROMPTPAY_ID=0105561008012

# SEED_DEMO_USERS: create the demo admin/manager/staff/customer accounts
# (password 123456) on startup. Local development only - never in production.
SEED_DEMO_USERS=false

# TRUSTED_PROXIES: comma-separated IPs/CIDRs of reverse proxies whose
# X-Forwarded-For header is believed (used for the per-IP login limit).
# Leave empty when nothing sits in front of the backend. Behind nginx etc.,
# set it to the proxy's address, or every customer looks like one IP.
TRUSTED_PROXIES=
