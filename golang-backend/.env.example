# DATABASE_URL: PostgreSQL Connection String
DATABASE_URL=postgres://arena_user:ArenaSecurePass99@localhost:5432/arena_db?sslmode=disable

# PORT: The port that Go Backend listens on
PORT=8080

# JWT_SECRET: signs login tokens. Generate your own, e.g. `openssl rand -hex 32`.
# If unset (or left at the old published example value) the server uses a
# random secret per run - safe, but everyone is logged out on restart.
JWT_SECRET=

# PROMPTPAY_ID: merchant PromptPay ID (phone or 13-digit tax ID) that
# customers' QR codes pay to. Required in production: the server refuses to
# start in release mode (GIN_MODE=release) without it, or with the old
# example ID 0105561008012. In development the QR uses that example ID.
PROMPTPAY_ID=

# SEED_DEMO_USERS: create the demo admin/manager/staff/customer accounts
# (password 123456) on startup. Local development only - never in production.
SEED_DEMO_USERS=false

# Database safety limits (optional; defaults shown). A statement running
# longer than DB_STATEMENT_TIMEOUT_MS, or waiting for a lock longer than
# DB_LOCK_TIMEOUT_MS, is cancelled ("busy, try again") instead of piling up.
# DB_MAX_OPEN_CONNS caps the connection pool (keep below Postgres max_connections).
# DB_STATEMENT_TIMEOUT_MS=90000   (requests stop at 30 s / reports at 90 s on their own)
# DB_LOCK_TIMEOUT_MS=5000
# DB_MAX_OPEN_CONNS=20

# Start-up and shutdown (optional; defaults shown). On start the server waits
# up to DB_CONNECT_TIMEOUT_SECONDS for the database (retrying) before it
# listens. On SIGTERM / Ctrl+C it stops taking new requests, lets requests in
# progress finish for up to SHUTDOWN_TIMEOUT_SECONDS, then closes the
# database (a second signal stops it at once; exit status 1 if the server
# failed, e.g. port taken). GET /healthz = process is up; GET /readyz = ready for traffic
# (database reachable) - point a load balancer / container health check at it.
# DB_CONNECT_TIMEOUT_SECONDS=60
# SHUTDOWN_TIMEOUT_SECONDS=30

# TRUSTED_PROXIES: comma-separated IPs/CIDRs of reverse proxies whose
# X-Forwarded-For header is believed (used for the per-IP login limit).
# Leave empty when nothing sits in front of the backend. Behind nginx etc.,
# set it to the proxy's address, or every customer looks like one IP.
TRUSTED_PROXIES=

# CORS_ALLOWED_ORIGINS: comma-separated origins allowed to call the API from
# a browser on another site (e.g. https://book.example.com). Empty sends no
# CORS headers: only pages served from the API's own address can call it
# (right when the website and /api share one address, as in deploy/).
CORS_ALLOWED_ORIGINS=

# Court counts: how many courts of each type exist (checked on every start).
# Raising a number adds the missing courts; lowering it never deletes a court
# (bookings point at it) - the server logs a warning and the admin closes the
# extra ones in Admin -> บริหารสนาม. Each basketball court is a full court
# plus its left and right halves (A, B, C, ... up to 26). Defaults shown.
# BASKETBALL_COURT_COUNT=3
# BADMINTON_COURT_COUNT=12
# PICKLEBALL_COURT_COUNT=3
# MEETING_ROOM_COUNT=1

# No-show rules (optional; defaults shown). Staff can mark a no-show from
# NO_SHOW_GRACE_MINUTES after the hour starts; the hour is then free and
# re-sold at NO_SHOW_RESALE_PRICE_PERCENT (1-100; 100 = full price) of the
# court's normal non-member price - a half court of its half price - never
# above the customer's normal price. The paid no-show is kept.
# NO_SHOW_GRACE_MINUTES=15
# NO_SHOW_RESALE_PRICE_PERCENT=50
