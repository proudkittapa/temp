# VITE_DATA_SOURCE: "api" sends login/bookings/slip review through the Go
# backend (see src/api.ts); anything else keeps the localStorage-only mode.
# `npm run dev:api` sets this for you.
VITE_DATA_SOURCE=local
# VITE_API_BASE_URL: where the Go API lives (default /api/v1, proxied by Vite)
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#   ...another address than the page: then also set CORS_ALLOWED_ORIGINS in
#   golang-backend/.env to the page's address (e.g. http://localhost:3000),
#   or the browser blocks every request (no CORS headers by default).

# Court counts for the browser-only mode (`npm run dev`); same names and
# defaults as golang-backend/.env.example. In API mode the backend decides.
# BASKETBALL_COURT_COUNT=3
# BADMINTON_COURT_COUNT=12
# PICKLEBALL_COURT_COUNT=3
# MEETING_ROOM_COUNT=1
# Hours per booking for the browser-only mode (default 3; API mode: the
# backend's MAX_HOURS_PER_BOOKING).
# MAX_HOURS_PER_BOOKING=3
